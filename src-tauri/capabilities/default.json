{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "shell:allow-execute",
    "shell:allow-open",
    "shell:default",
    {
      "identifier": "shell:allow-execute",
      "allow": [
        {
          "cmd": "python3",
          "args": true,
          "name": "python3"
        },
        {
          "cmd": "/usr/bin/python3",
          "args": true,
          "name": "python3_abs"
        },
        {
          "cmd": "rivalcfg",
          "args": true,
          "name": "rivalcfg"
        }
      ]
    }
  ]
}