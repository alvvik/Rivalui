pkgname=rivalui
pkgver=0.1.3
pkgrel=1
pkgdesc="RivalUI Tauri Application"
arch=('x86_64')
url="https://github.com/alvv/RivalUI"
license=('MIT')
depends=('webkit2gtk-4.1' 'gtk3' 'glib2' 'python' 'rivalcfg' 'hicolor-icon-theme')
optdepends=('python-pip: for python modules support')
source=('rivalui.tar.gz')
sha256sums=('SKIP')

package() {
  cd "$srcdir"

  if [ -f "usr/bin/app" ]; then
    install -Dm755 usr/bin/app "$pkgdir/usr/bin/rivalui"
  fi

  if [ -d "usr/lib/RivalUI" ]; then
    install -dm755 "$pkgdir/usr/lib/rivalui"
    cp -r usr/lib/RivalUI/* "$pkgdir/usr/lib/rivalui/"
  fi

  if [ -d "usr/share/applications" ]; then
    install -dm755 "$pkgdir/usr/share/applications"
    cp usr/share/applications/*.desktop "$pkgdir/usr/share/applications/"
    files=("$pkgdir/usr/share/applications/"*.desktop)
    if [ -e "${files[0]}" ]; then
      sed -i 's|Exec=.*|Exec=rivalui|' "${files[@]}"
    fi
  fi

  if [ -d "usr/share/icons" ]; then
    cp -r usr/share/icons "$pkgdir/usr/share/"
  fi
}
